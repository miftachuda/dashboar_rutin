fetch('/PeopleReviewV2/Services/KPI.asmx/GetEvaluatorSynthesisFeedBack', {
  method: 'POST',
  headers: { 'Content-Type': 'application/json; charset=utf-8' },
  credentials: 'include',
  body: JSON.stringify({"PERIOD_ID":"2025","WORKFLOW_ID":"1","PERNR":"752954","EVALUATOR_PERNR":"731943"}{
    periodID: document.getElementById('hdPeriodID').value,      // 2025
    activityID: '100010',                                       // KEY: 100010 = draft, 100011 = sent/final
    pernr: document.getElementById('hdNoPek').value,
    evaluator_pernr: document.getElementById('hdEvNoPek').value,
    workflow: document.getElementById('hdfWFID').value,
  }),
}).then(r => r.json()).then(r => console.log(JSON.parse(r.d.Data)));




